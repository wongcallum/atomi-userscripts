{
  "name": "atomi-userscripts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./packages/* dev",
    "build": "pnpm -r --filter=./packages/* build",
    "serve": "pnpm --filter=atomi-ai-marking serve",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./tools/* typecheck",
    "mock-llm": "node tools/mock-llm/main.ts serve",
    "mock-llm:scenario": "node tools/mock-llm/main.ts scenario",
    "mock-llm:last": "node tools/mock-llm/main.ts last",
    "browser": "firefox --no-remote --profile \"$HOME/.firefox-devtools-mcp/profiles/atomi-userscripts/firefox_devtools_mcp_profile\"",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  },
  "packageManager": "pnpm@11.24.0"
}
